# Copia este archivo como .env y completa los valores. Nunca subas el .env.
PORT=3000

# Supabase (SERVICE_ROLE_KEY es secreta: solo existe en el backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (interpreta los mensajes del bot)
GROQ_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# Solo en produccion (el bot recibe mensajes por webhook).
# En local dejalos vacios: el bot usa polling.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
